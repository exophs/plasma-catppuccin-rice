{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "right": 3 }, "color": { "1": "#cba6f7", "2": "#b4befe" } },
  "display": {
    "separator": "  ",
    "color": { "keys": "#cba6f7", "title": "#b4befe" },
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;88;91;112m─────────────────────────────" },
    { "type": "os",       "key": " os",     "keyColor": "#cba6f7" },
    { "type": "kernel",   "key": " kernel", "keyColor": "#b4befe" },
    { "type": "packages", "key": "󰏗 pkgs",   "keyColor": "#89b4fa" },
    { "type": "de",       "key": " de",     "keyColor": "#74c7ec" },
    { "type": "wm",       "key": " wm",     "keyColor": "#94e2d5" },
    { "type": "shell",    "key": " shell",  "keyColor": "#a6e3a1" },
    { "type": "terminal", "key": " term",   "keyColor": "#f9e2af" },
    { "type": "cpu",      "key": " cpu",    "keyColor": "#fab387" },
    { "type": "gpu",      "key": "󰢮 gpu",    "keyColor": "#eba0ac" },
    { "type": "memory",   "key": " mem",    "keyColor": "#f38ba8" },
    { "type": "uptime",   "key": "󰅐 uptime", "keyColor": "#f5c2e7" },
    { "type": "custom", "format": "\u001b[38;2;88;91;112m─────────────────────────────" },
    "colors"
  ]
}
